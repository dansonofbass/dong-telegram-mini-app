{
  "name": "dong",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run i18n:check && tsc --noEmit && vite build --configLoader runner",
    "start": "tsx server/index.ts --production",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@fontsource/lato": "^5.2.0",
    "@fontsource/noto-sans-arabic": "^5.2.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.1"
  }
}
