# Local development (copy to .env)
PORT=3000
HOST=localhost
DATA_DIR=./data
DEMO_MODE=true
# Vercel Production: NODE_ENV=production and DEMO_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=
APP_BASE_URL=http://localhost:3000
# Leave both blank locally. Production requires a remote libSQL database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Preview only: use a separate disposable database and explicitly opt in.
ALLOW_PREVIEW_DATABASE=false
# One-time migration command only; do not configure in Vercel.
CONFIRM_DATABASE_MIGRATION=no
